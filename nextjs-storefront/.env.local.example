# ─────────────────────────────────────────────────────────────────
# nextjs-storefront/.env.local
# Copy to .env.local and fill in values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── Medusa Store API ──────────────────────────────────────────────
# Public — safe to expose to browser.
# Points to the Medusa backend URL (via Cloudflare Tunnel in prod).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.medstore.flowcrafted.me

# Publishable API Key scoped to "Online Store" sales channel.
# Generate in Medusa Admin → Settings → Publishable API Keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_REPLACE_WITH_YOUR_PUBLISHABLE_KEY

# ── ISR Revalidation ──────────────────────────────────────────────
# Server-side only — NEVER prefix with NEXT_PUBLIC_.
# Used to authenticate the POST /api/revalidate webhook from n8n.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Shop Contact Info ─────────────────────────────────────────────
# These appear in the homepage hero and product detail CTAs.
NEXT_PUBLIC_SHOP_NAME=MedStore Pharmacy
NEXT_PUBLIC_SHOP_PHONE=+919999999999
NEXT_PUBLIC_SHOP_WHATSAPP=919999999999
NEXT_PUBLIC_SHOP_ADDRESS=123 Main Street, Your City, State - 400001
NEXT_PUBLIC_SHOP_HOURS=Mon–Sat: 9am–9pm, Sun: 10am–6pm
