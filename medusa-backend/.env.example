# ─────────────────────────────────────────────────────────────────
# medusa-backend/.env
# Copy this to .env and fill in real values.
# NEVER commit .env to git — it is gitignored.
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# For Docker Compose, use the service name "postgres" as host.
# For local dev outside Docker, use "localhost" (or 127.0.0.1).
DATABASE_URL=postgres://medusa:CHANGE_ME_STRONG_PASSWORD@postgres:5432/medusa_medstore

# ── Redis ─────────────────────────────────────────────────────────
# DB index 2 keeps this project isolated from other apps sharing
# the same Redis instance.
REDIS_URL=redis://redis:6379/2

# ── Secrets ───────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
# These MUST remain stable — changing them invalidates all sessions.
JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
COOKIE_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── CORS ──────────────────────────────────────────────────────────
# Exact origins only — no trailing slashes, no wildcards in prod.
ADMIN_CORS=https://admin.medstore.flowcrafted.me
STORE_CORS=https://medstore.flowcrafted.me
AUTH_CORS=https://admin.medstore.flowcrafted.me,https://medstore.flowcrafted.me

# ── Medusa ────────────────────────────────────────────────────────
MEDUSA_BACKEND_URL=https://api.medstore.flowcrafted.me
PORT=9000
# Override to 'worker' in docker-compose for the medusa-worker service
MEDUSA_WORKER_MODE=server
NODE_ENV=production

# ── Cloudinary ────────────────────────────────────────────────────
# Get these from Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# All product images stored under this folder in your Cloudinary account
CLOUDINARY_FOLDER=medstore
